{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Potato",
  "identifier": "io.agentscope.qwenpaw.desktop",
  "build": {
    "frontendDist": "../../app/dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm --prefix ../app run dev",
    "beforeBuildCommand": "npm --prefix ../app run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Potato",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 30 },
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' http://127.0.0.1:* ws://127.0.0.1:* ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' https://fonts.gstatic.com",
        "img-src": "'self' asset: http://asset.localhost http://127.0.0.1:* blob: data: https:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "icon": [
      "../../scripts/pack/assets/icon.icns",
      "../../scripts/pack/assets/icon.ico"
    ],
    "resources": [
      "binaries/potato-backend",
      "binaries/python-runtime",
      "binaries/node-runtime",
      "binaries/cua-driver"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "../../scripts/pack/assets/icon.ico",
        "uninstallerIcon": "../../scripts/pack/assets/icon.ico",
        "installerHooks": "nsis-hooks.nsh",
        "languages": [
          "English",
          "SimpChinese",
          "Indonesian",
          "Japanese",
          "Russian",
          "PortugueseBR",
          "Vietnamese"
        ],
        "customLanguageFiles": {
          "English": "nsis-languages/English.nsh",
          "SimpChinese": "nsis-languages/SimpChinese.nsh",
          "Indonesian": "nsis-languages/Indonesian.nsh",
          "Japanese": "nsis-languages/Japanese.nsh",
          "Russian": "nsis-languages/Russian.nsh",
          "PortugueseBR": "nsis-languages/PortugueseBR.nsh"
        },
        "compression": "zlib",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDRjU1RTE4NTRBNTZGMzQKUldRMGI2VlVHRjcxdkhBNk1yMmkvdTlpd2dDY2duU3hJMlp4cnFEUmJyTVp0eUkzb0JBcGhWaXYK",
      "endpoints": [
        "https://chat.recodex.top/potato-updates/metadata/potato-tauri-latest.json",
        "https://chat.recodex.top/potato-updates/metadata/qwenpaw-tauri-latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
